    <worksheet name='Salary x work_activities'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Applied Skills Separate High and Low Performers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='demographics' name='federated.0e85xo51uw6vm51h4mzgl0pngnr3' />
          </datasources>
          <datasource-dependencies datasource='federated.0e85xo51uw6vm51h4mzgl0pngnr3'>
            <column datatype='string' name='[Salary Usd (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[salary_usd]' new-bin='true'>
                <bin default-name='false' value='&quot;High Productivity&quot;'>
                  <value>&quot;$125,000+&quot;</value>
                  <value>&quot;$70,000-$124,999&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Low Productivity&quot;'>
                  <value>&quot;$30,000-$69,999&quot;</value>
                  <value>&quot;under $30,000&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='languages.csv' datatype='table' name='[__tableau_internal_object_id__].[languages.csv_148442042C8A4BBDAE4841F7B905479A]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[languages.csv_148442042C8A4BBDAE4841F7B905479A]' derivation='Count' name='[__tableau_internal_object_id__].[pcto:cnt:languages.csv_148442042C8A4BBDAE4841F7B905479A:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Job Title' datatype='string' name='[job_title]' role='dimension' type='nominal' />
            <column-instance column='[job_title]' derivation='None' name='[none:job_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[work_activity]' derivation='None' name='[none:work_activity:nk]' pivot='key' type='nominal' />
            <column caption='Salary Usd' datatype='string' name='[salary_usd]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='&quot;$30,000-$69,999&quot;' value='$30-69K' />
                <alias key='&quot;$70,000-$124,999&quot;' value='$70-125K' />
              </aliases>
            </column>
            <column caption='Work Activity' datatype='string' name='[work_activity]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Analyze and understand data to influence product or business decisions&quot;' value='Data Storytelling' />
                <alias key='&quot;Build and/or run a machine learning service that operationally improves my product or workflows&quot;' value='Build ML Models' />
                <alias key='&quot;Build and/or run the data infrastructure that my business uses for storing, analyzing, and operationalizing data&quot;' value='Data Engineering' />
                <alias key='&quot;Build prototypes to explore applying machine learning to new areas&quot;' value='Apply ML Models' />
                <alias key='&quot;Do research that advances the state of the art of machine learning&quot;' value='Research ML' />
                <alias key='&quot;Experimentation and iteration to improve existing ML models&quot;' value='Improve  Models' />
                <alias key='&quot;None of these activities are an important part of my role at work&quot;' value='None of these' />
              </aliases>
            </column>
          </datasource-dependencies>
